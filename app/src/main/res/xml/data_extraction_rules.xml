<?xml version="1.0" encoding="utf-8"?>
<!-- The auth store is encrypted with a device-bound Keystore key that never leaves the device, so a
     restored copy can't be decrypted (crashes at startup). Keep it, and its Tink keysets, out of backups. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bookorbit_secure_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bookorbit_secure_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Themes the legacy MediaRouteButton itself (CastButton.kt wraps its context in these so the
         icon tint matches the app's light/dark mode rather than the system's). The colorPrimary /
         colorBackground items exist for the same MediaRouterThemeHelper contrast check described
         on Theme.BookOrbit in the main flavor's themes.xml - it runs against whatever theme the
         button's own context carries, which is this one, not the activity's. Full flavor only:
         extends androidx.mediarouter's own Theme.MediaRouter(.Light), which isn't on the fdroid
         flavor's classpath. -->
    <style name="Theme.BookOrbit.MediaRouter" parent="@style/Theme.MediaRouter">
        <item name="android:colorBackground">@color/background</item>
        <item name="colorPrimary">@color/accent</item>
    </style>
    <style name="Theme.BookOrbit.MediaRouter.Light" parent="@style/Theme.MediaRouter.Light">
        <item name="android:colorBackground">@color/background</item>
        <item name="colorPrimary">@color/accent</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<!-- Merged into the main manifest for the "full" flavor only. See the flavor comment in
     app/build.gradle.kts and app/src/full/java/com/bookorbit/feature/cast/. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Cast SDK entry point: points at the OptionsProvider that configures the stock Default
             Media Receiver as the cast target (no custom receiver app). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.bookorbit.feature.cast.CastOptionsProvider" />
    </application>

</manifest>
